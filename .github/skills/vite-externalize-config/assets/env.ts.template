// ---- src/config/env.ts ----
// Use STATIC access (import.meta.env.VITE_X). Dynamic access (import.meta.env[key])
// makes Vite inline every VITE_* variable present at build time, including secrets.

const required = (name: string, value: string | undefined, fallback?: string): string => {
  const resolved = value ?? fallback;
  if (resolved === undefined || resolved === '') {
    throw new Error(`Missing required env var: ${name}`);
  }
  return resolved;
};

const toNumber = (name: string, value: string | undefined, fallback: number): number => {
  const parsed = Number(value ?? fallback);
  if (Number.isNaN(parsed)) throw new Error(`Env var ${name} must be a number`);
  return parsed;
};

const toBool = (value: string | undefined, fallback = false): boolean =>
  value === undefined ? fallback : value === 'true';

export const env = {
  siteUrl: required('VITE_SITE_URL', import.meta.env.VITE_SITE_URL, 'http://localhost:3000'),
  requestTimeoutMs: toNumber('VITE_REQUEST_TIMEOUT_MS', import.meta.env.VITE_REQUEST_TIMEOUT_MS, 15000),
  features: {
    example: toBool(import.meta.env.VITE_FEATURE_EXAMPLE),
  },
} as const;

export type Env = typeof env;

// ---- src/vite-env.d.ts ----
/// <reference types="vite/client" />
// Do NOT declare VITE_MONDAY_API_TOKEN here — it is for nginx / the dev proxy only.
interface ImportMetaEnv {
  readonly VITE_SITE_URL?: string;
  readonly VITE_REQUEST_TIMEOUT_MS?: string;
  readonly VITE_FEATURE_EXAMPLE?: string;
}
interface ImportMeta {
  readonly env: ImportMetaEnv;
}

