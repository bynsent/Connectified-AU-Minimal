// ---- src/config/env.ts ----
type EnvKey = keyof ImportMetaEnv;

const read = (key: EnvKey, fallback?: string): string => {
  const value = import.meta.env[key] ?? fallback;
  if (value === undefined || value === '') {
    throw new Error(`Missing required env var: ${String(key)}`);
  }
  return value;
};

const readNumber = (key: EnvKey, fallback: number): number => {
  const parsed = Number(import.meta.env[key] ?? fallback);
  if (Number.isNaN(parsed)) throw new Error(`Env var ${String(key)} must be a number`);
  return parsed;
};

const readBool = (key: EnvKey, fallback = false): boolean => {
  const raw = import.meta.env[key];
  return raw === undefined ? fallback : raw === 'true';
};

export const env = {
  apiBaseUrl: read('VITE_API_BASE_URL', '/api'),
  siteUrl: read('VITE_SITE_URL', 'http://localhost:3000'),
  requestTimeoutMs: readNumber('VITE_REQUEST_TIMEOUT_MS', 15000),
  features: {
    example: readBool('VITE_FEATURE_EXAMPLE'),
  },
} as const;

export type Env = typeof env;

// ---- src/vite-env.d.ts ----
/// <reference types="vite/client" />
interface ImportMetaEnv {
  readonly VITE_API_BASE_URL?: string;
  readonly VITE_SITE_URL?: string;
  readonly VITE_REQUEST_TIMEOUT_MS?: string;
  readonly VITE_FEATURE_EXAMPLE?: string;
}
interface ImportMeta {
  readonly env: ImportMetaEnv;
}
