# MONDAY_API_TOKEN: Required for the /api/monday proxy route (server.js).
# Used by SIMSignupPage, SIMTicketPage, and ContactPage form submissions.
# Set the real value as a runtime environment variable / secret on the
# Azure Container App — never commit the real token to this file or to git.
MONDAY_API_TOKEN="MY_MONDAY_API_TOKEN"

# PORT: Optional. Defaults to 8080 if not set.
PORT="8080"

# --- The following were part of the original AI Studio template export ---
# --- and are NOT currently referenced anywhere in the app's components. ---
# --- Remove if confirmed unused; kept here only for reference.         ---
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
