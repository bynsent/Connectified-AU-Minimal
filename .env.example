# VITE_MONDAY_API_TOKEN (required, SECRET)
# Monday.com API token. Consumed ONLY by:
#   - nginx at container start (envsubst into nginx.conf -> Authorization header on /api/monday)
#   - the Vite dev-server proxy for /api/monday during `npm run dev` (put it in .env.local)
# Never reference it from src/ and never pass it as a Docker build arg.
# In Azure set it as a secret-backed environment variable on the Container App.
VITE_MONDAY_API_TOKEN="your-monday-api-token"

# DISABLE_HMR (optional, dev only)
# Set to "true" to disable Vite HMR (used by AI Studio).
DISABLE_HMR="false"

